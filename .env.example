# Database Configuration
DB_SERVER=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=biometric_atm_db
DB_CHARSET=utf8mb4

# Security Configuration [REQUIRED]
# CRITICAL: Must be 32-byte random hex string. Used for HMAC signing between services.
SHARED_SECRET=
# CRITICAL: Must be 32-char random string. Used for database encryption.
ENCRYPTION_KEY=

# Application Settings
BIOMETRIC_THRESHOLD=85.0
MAX_LOGIN_ATTEMPTS=3
SESSION_TIMEOUT=1800

# Environment
APP_ENV=development
DEBUG=true