# ==============================================================================
# BIOMETRIC ATM SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in all required values
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
DEBUG=true                          # true | false (must be false in production)
BANK_NAME=Ghana Secure Bank
CURRENCY=GHS
TIMEZONE=Africa/Accra

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (Docker Compose)
DB_HOST=db                          # Use 'db' for Docker Compose, localhost for local
DB_PORT=3306
DB_USER=biometric
DB_PASS=biometricpass
DB_NAME=biometric_atm_db
DB_CHARSET=utf8mb4

# Production (AWS RDS) - Use Secrets Manager in production
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_USER=admin
# DB_PASS=your-secure-password
# DB_NAME=biometric_atm_db

# ------------------------------------------------------------------------------
# SECURITY CONFIGURATION (REQUIRED - Generate secure random values)
# ------------------------------------------------------------------------------
# CRITICAL: Must be 32-byte (64-char) random hex string for HMAC signing
# Generate with: openssl rand -hex 32
SHARED_SECRET=

# CRITICAL: Must be 32-char random string for database encryption
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# BIOMETRIC SETTINGS
# ------------------------------------------------------------------------------
BIOMETRIC_THRESHOLD=85.0            # Minimum confidence % for authentication (50-100)
MAX_LOGIN_ATTEMPTS=3                # Max failed attempts before lockout
SESSION_TIMEOUT=1800                # Session timeout in seconds (30 min)
MAX_REQUEST_AGE=300                 # Max request age for replay protection (5 min)

# ------------------------------------------------------------------------------
# PYTHON BIOMETRIC SERVICE
# ------------------------------------------------------------------------------
PYTHON_SERVICE_HOST=biometric       # Service hostname (Docker Compose)
PYTHON_SERVICE_PORT=5000
PYTHON_SERVICE_URL=http://biometric:5000/verify

# ------------------------------------------------------------------------------
# AWS CONFIGURATION (Production)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# ECR Registry
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ECR_REPOSITORY_PREFIX=biometric-atm

# RDS Database (Production)
# RDS_ENDPOINT=
# RDS_PORT=3306
# RDS_DB_NAME=biometric_atm_db

# Secrets Manager ARNs (Production)
# SHARED_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name
# ENCRYPTION_KEY_ARN=arn:aws:secretsmanager:region:account:secret:name
# DB_PASSWORD_ARN=arn:aws:secretsmanager:region:account:secret:name

# ALB Configuration
ALB_DNS_NAME=
ALB_ARN=
ALB_SECURITY_GROUP=
ALB_TARGET_GROUP_WEB=
ALB_TARGET_GROUP_BIOMETRIC=

# ECS Configuration
ECS_CLUSTER=biometric-atm-cluster
ECS_SERVICE_WEB=biometric-web-service
ECS_SERVICE_BIOMETRIC=biometric-python-service
ECS_TASK_DEFINITION_WEB=biometric-web-task
ECS_TASK_DEFINITION_BIOMETRIC=biometric-python-task

# CloudWatch
CLOUDWATCH_LOG_GROUP_WEB=/ecs/biometric-web
CLOUDWATCH_LOG_GROUP_BIOMETRIC=/ecs/biometric-python
CLOUDWATCH_LOG_GROUP_NGINX=/ecs/biometric-nginx

# ------------------------------------------------------------------------------
# SSL/TLS CONFIGURATION
# ------------------------------------------------------------------------------
# Production: Use AWS Certificate Manager (ACM)
# SSL_CERT_ARN=arn:aws:acm:region:account:certificate/id
# SSL_KEY_PATH=
# SSL_CERT_PATH=

# Development: Self-signed certs (generate with mkcert)
# SSL_CERT_PATH=./docker/ssl/cert.pem
# SSL_KEY_PATH=./docker/ssl/key.pem

# ------------------------------------------------------------------------------
# MONITORING & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=info                       # debug | info | warn | error
LOG_FORMAT=json                      # json | text
SENTRY_DSN=                          # Optional: Sentry error tracking

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_WEB_AUTHN=true                # Enable WebAuthn/FIDO2 support
ENABLE_WINDOWS_HELLO=true            # Enable Windows Hello integration
ENABLE_INFRARED_CAMERA=false         # Enable IR camera support
ENABLE_RATE_LIMITING=true            # Enable API rate limiting
ENABLE_AUDIT_LOGGING=true            # Enable detailed audit logging
ENABLE_DEVICE_FINGERPRINTING=true    # Enable device fingerprint collection

# ------------------------------------------------------------------------------
# NGINX REVERSE PROXY (Production)
# ------------------------------------------------------------------------------
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=10M
NGINX_PROXY_READ_TIMEOUT=60s
NGINX_PROXY_SEND_TIMEOUT=60s

# ------------------------------------------------------------------------------
# BACKUP & MAINTENANCE
# ------------------------------------------------------------------------------
BACKUP_SCHEDULE=0 2 * * *            # Daily at 2 AM UTC
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=                    # S3 bucket for backups

# ==============================================================================
# GENERATION COMMANDS
# ==============================================================================
# Generate SHARED_SECRET:     openssl rand -hex 32
# Generate ENCRYPTION_KEY:    openssl rand -hex 16
# Generate DB_PASSWORD:       openssl rand -base64 32
# Generate JWT_SECRET:        openssl rand -hex 32
# ==============================================================================