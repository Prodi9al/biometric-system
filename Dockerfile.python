FROM python:3.11-slim

ARG BUILD_DATE
ARG VERSION
LABEL maintainer="Biometric ATM System" \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.title="Biometric ATM - Python Service" \
      org.opencontainers.image.description="Secure biometric verification service with face recognition"

# Install system dependencies for OpenCV, face_recognition, dlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libglib2.0-0 \
    libgtk-3-0 \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libatlas-base-dev \
    gfortran \
    libopenblas-dev \
    liblapack-dev \
    libhdf5-dev \
    python3-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY python/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt

# Copy Python service code
COPY python/biometric_service.py .
COPY python/biometric_capture.py .
COPY python/face_recognition_core.py .
COPY python/fingerprint_core.py .
COPY python/start_service.py .

# Create non-root user
RUN groupadd -r biometric && useradd -r -g biometric biometric \
    && chown -R biometric:biometric /app

USER biometric

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run service
CMD ["python", "biometric_service.py"]